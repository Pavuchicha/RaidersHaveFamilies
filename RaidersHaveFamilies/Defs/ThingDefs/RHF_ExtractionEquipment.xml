<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>RHF_ExtractionPod</defName>
    <label>improvised evacuation pod</label>
    <description>LEGACY DEF (save compatibility only). Modern NJR VIP flight uses the physical vanilla TransportPod / PodLauncher instead of this decorative old experimental object.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>RaidersHaveFamilies/FieldPod</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.2</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases><MaxHitPoints>240</MaxHitPoints><WorkToBuild>2800</WorkToBuild></statBases>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>RHF_FieldLauncher</defName>
    <label>improvised pod launcher</label>
    <description>LEGACY DEF (save compatibility only). Modern NJR VIP flight builds the physical vanilla PodLauncher. Not a functional launch object.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>RaidersHaveFamilies/FieldLauncher</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.2</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases><MaxHitPoints>180</MaxHitPoints><WorkToBuild>2100</WorkToBuild></statBases>
  </ThingDef>
</Defs>
